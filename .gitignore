# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local-only: scraped datasets, browser profiles, tooling
# GitHub holds the Next.js app only -- these live on the machine that runs the scrapers
/data
/scripts
/sql

# scraper entry points (kept local, not part of the app build)
/cmrkt-stealth-scraper.mjs
/scrape-all-cards.mjs
/scrape-global-database.mjs
/test-cmrkt-scrape.mjs
/update-counts.mjs

# scraper output and run logs
*.log
.daily-*
.western-*
.jp-*
/cardmarket-chart-data.json
/cmrkt-stealth-log.txt
/counts-log.txt
/cmrkt-stealth-check.png
/test-cmrkt-result.html
/test-cmrkt-result.png
